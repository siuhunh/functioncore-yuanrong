ARG  VERSION
FROM runtime-manager:${VERSION}

ENV RUNTIME_HOME=/home/snuser

COPY --chown=1003:1003 RunTime-2.0.6.jar ${RUNTIME_HOME}/runtime/java/
COPY --chown=1000:1000 apm-javaagent ${RUNTIME_HOME}/apm-javaagent

RUN find ${RUNTIME_HOME}/apm-javaagent -type d | xargs chmod 750 && \
    find ${RUNTIME_HOME}/apm-javaagent -type f | xargs chmod 740

USER root

RUN npm config set registry https://szg1.artifactory.inhuawei.com/artifactory/api/npm/cbu-npm-public && \
    npm config set strict-ssl false && \
    npm install -S @cloud/nodejs-agent@1.0.70 && \
    npm install -S axios@0.27.2 && \
    npm install -S ioredis@5.2.3 && \
    chown -R 1003:1003 node_modules && \
    find node_modules -type d | xargs chmod 550 && \
    find node_modules -type f | xargs chmod 440 && \
    mv -n node_modules/* /opt/function/runtime/nodejs14.18/rtsp/nodejs/node_modules && \
    rm -rf node_modules package-lock.json

USER 1000

ENTRYPOINT ["/bin/bash", "/home/sn/bin/entrypoint"]