ARG  VERSION
FROM runtime-manager:${VERSION}

ENV PATH=${CANGJIE_HOME}/bin:${CANGJIE_HOME}/tools/bin:$PATH \
    LD_LIBRARY_PATH=${CANGJIE_HOME}/runtime/lib/linux_x86_64_llvm:${LD_LIBRARY_PATH}

RUN mkdir -m 550 ${HOME}/runtime/cangjie1.0 && \
    mkdir -m 550 ${HOME}/runtime/cangjie0.52.3
# cangjie
COPY --chown=1003:1003 cangjieruntime/cangjie1.0/bin/entrypoint_runtime_cangjie ${HOME}/bin/entrypoint
COPY --chown=1003:1003 cangjieruntime/cangjie1.0/pkg/runtime/cangjie/bin ${HOME}/runtime/cangjie1.0
COPY --chown=1003:1003 cangjieruntime/cangjie1.0/pkg/runtime/cangjie/yuanrong_runtime_sdk/libyuanrong_runtime_sdk_yuanrong_sdk.so ${HOME}/runtime/cangjie1.0

# cangjie 0.52.3
COPY --chown=1003:1003 cangjieruntime/cangjie0.52.3/bin/entrypoint_runtime_cangjie ${HOME}/bin/entrypoint
COPY --chown=1003:1003 cangjieruntime/cangjie0.52.3/pkg/runtime/cangjie/bin ${HOME}/runtime/cangjie0.52.3
COPY --chown=1003:1003 cangjieruntime/cangjie0.52.3/pkg/runtime/cangjie/yuanrong_runtime_sdk/libyuanrong_runtime_sdk_yuanrong_sdk.so ${HOME}/runtime/cangjie0.52.3

RUN chmod 755 -R ${HOME}/runtime/cangjie1.0 && \
    chmod 755 -R ${HOME}/runtime/cangjie0.52.3 && \
    chown -R 1003:1003 /opt/huawei

ENTRYPOINT ["/bin/bash", "/home/sn/bin/entrypoint"]