set -e

cp -r /home/sn/* /home/safety

cd /home/safety

find ./ -type d | xargs chmod 500
find ./ -type f | xargs chmod 400

chmod 700 /home/safety/log

chown -R "${USER_UID}":"${GROUP_ID}" /home/safety

find ./ -type f | xargs ls -l

echo "succeeded in supporting file permissions"

exit 0
