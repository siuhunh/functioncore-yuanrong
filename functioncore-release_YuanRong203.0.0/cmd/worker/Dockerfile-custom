FROM custom:1.0

ENV USER_UID=1002 \
    USER_NAME=sn \
    GROUP_ID=1002 \
    GROUP_NAME=sn

ENV HOME=/home/${USER_NAME} \
    DEPLOY=${HOME}/bin/worker \
    LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/usr/local/lib

RUN mkdir -p ${HOME}/bin && \
    groupadd -g ${GROUP_ID} ${GROUP_NAME} && \
    useradd -u ${USER_UID} -g ${GROUP_ID} -s /sbin/nologin ${USER_NAME} && \
    chown -R ${USER_UID}:${GROUP_ID} ${HOME} && \
    echo "sn    ALL=NOPASSWD:/bin/bash /home/sn/bin/sudo_init.sh" >> /etc/sudoers

# USER_UID GROUP_ID 1002
COPY --chown=1002:1002 bin ${HOME}/bin
COPY --chown=1002:1002 bin/worker ${DEPLOY}
COPY --chown=1002:1002 config ${HOME}/config

RUN find ${HOME}/config -type d | xargs chmod 500 && \
    find ${HOME}/config -type f | xargs chmod 400 && \
    find ${HOME}/bin -type d | xargs chmod 500 && \
    find ${HOME}/bin -type f | xargs chmod 400

EXPOSE 8080

USER ${USER_UID}

WORKDIR ${HOME}

ENTRYPOINT ["/bin/bash", "/home/sn/bin/entrypoint"]
