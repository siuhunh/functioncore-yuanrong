FROM worker-init:1.0

ENV USER_UID=1000 \
    USER_NAME=sn \
    GROUP_ID=1000 \
    GROUP_NAME=sn \
    HOME=/home/sn

RUN mkdir -p ${HOME}/script && \
    chown -R ${USER_UID}:${GROUP_ID} ${HOME} && \
    chmod u+s $(which iptables)

COPY --chown=1000:1000 scripts ${HOME}/script

RUN find ${HOME}/script -type d | xargs chmod 500 && \
    find ${HOME}/script -type f | xargs chmod 500

USER ${USER_UID}:${GROUP_ID}

ENTRYPOINT ["/bin/bash", "-c", "/home/sn/script/iptables.sh && /home/sn/script/copy_secret.sh"]

