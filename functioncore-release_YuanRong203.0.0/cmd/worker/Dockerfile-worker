FROM worker-init:1.0

ENV USER_UID=1000 \
    USER_NAME=sn \
    GROUP_ID=1000 \
    GROUP_NAME=sn \
    HOME=/home/sn \
    DEPLOY=${HOME}/bin/worker

RUN mkdir -p ${HOME}/runtime && \
    groupmod --new-name ${GROUP_NAME} paas && \
    usermod -l ${USER_NAME} paas -g ${GROUP_ID} && \
    usermod -s /sbin/nologin ${USER_NAME} && \
    usermod -aG root ${USER_NAME} && \
    chown -R ${USER_UID}:${GROUP_ID} /home && \
    chmod u+s $(which ip) && \
    chmod u+s $(which route) && \
    chmod u+s $(which ping) && \
    chmod u+s $(which iptables) && \
    echo "sn    ALL=NOPASSWD:/bin/bash /home/sn/bin/sudo_init.sh" >> /etc/sudoers && \
    echo "sn    ALL=NOPASSWD:/bin/bash -c ethtool -K tunl_fgs_vpc tso off" >> /etc/sudoers && \
    echo "sn    ALL=NOPASSWD:/bin/bash -c ethtool -K tunl_end_vpc tso off" >> /etc/sudoers && \
    echo "sn    ALL=NOPASSWD:/bin/bash -c dmesg -T | tail -100" >> /etc/sudoers && \
    echo "sn    ALL=NOPASSWD:/bin/mount" >> /etc/sudoers

# USER_UID GROUP_ID 1000
COPY --chown=1000:1000 bin ${HOME}/bin
COPY --chown=1000:1000  bin/worker ${DEPLOY}
COPY --chown=1000:1000  config ${HOME}/config
COPY --chown=1000:1000  bin/sudo_init.sh ${HOME}/bin/sudo_init.sh

RUN setcap 'cap_dac_override,cap_sys_admin,cap_sys_resource+ep' ${DEPLOY}

USER ${USER_UID}:${GROUP_ID}

RUN chmod 700 ${HOME} && \
    find ${HOME}/config -type d | xargs chmod 500 && \
    find ${HOME}/config -type f | xargs chmod 400 && \
    find ${HOME}/bin -type d | xargs chmod 500 && \
    find ${HOME}/bin -type f | xargs chmod 500

COPY --chown=1000:1000  datasystem/lib/* /usr/lib64/

EXPOSE 8080

WORKDIR ${HOME}

ENTRYPOINT ["/bin/bash", "/home/sn/bin/entrypoint"]

